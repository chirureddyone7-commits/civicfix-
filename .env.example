PORT=5000

# Hosted PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true

# Alternative local PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=civicfix

JWT_SECRET=replace_with_a_long_random_secret
OPENROUTER_API_KEY=

# Must be a vision-capable model supported by your OpenRouter account.
# Example: google/gemini-2.0-flash-001 (availability/pricing depends on provider).
OPENROUTER_VISION_MODEL=
